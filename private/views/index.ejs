<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🎉Confetti!🎉</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎉</text></svg>">

  <meta name="description" content="🎉🎉🎉🎉🎉🎉🎉">
  <meta property="og:title" content="🎉Confetti!🎉">
  <meta property="og:description" content="🎉🎉🎉🎉🎉🎉🎉">
  <meta property="og:image" content="https://xn--dk8haa.ws/confetti.png">
  <meta property="og:url" content="https://xn--dk8haa.ws">
</head>

<body>
  <div id="celebration-container">
    <div id="celebration-text"><%= message %></div>
  </div>
  <button type="button" id="custom-url-link">Create Custom URL</button>
  <div id="custom-url-input">
    <input type="text" id="custom-text" placeholder="Enter custom text" maxlength="<%= maxMessageLength %>" aria-label="Custom text">
    <button type="button" id="generate-link">Generate</button>
  </div>
  <div id="generated-url-display"></div>
  <div id="theme-toggle">
    <button type="button" id="theme-toggle-button">Dark Mode</button>
  </div>
  <script src="/app.js"></script>
</body>

</html>
